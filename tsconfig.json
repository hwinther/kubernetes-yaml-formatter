{
  "extends": "@wshno/tsconfig/base.json",
  "compilerOptions": {
    // CommonJS output for the extension host and the Mocha integration tests (out/); esbuild bundles
    // dist/ from the sources itself.
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "out",
    "rootDir": "src",
    "types": ["node", "mocha"],
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
